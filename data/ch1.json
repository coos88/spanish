  {
   "id": "l-possessives",
   "title": "Possessives and little words",
   "summary": "my, your, our, and the prepositions you need to say where things are.",
   "cards": [
    {
     "rule": "**mi** (my), **tu** (your), **su** (his / her / your formal / their), **nuestro/a** (our), **vuestro/a** (your pl). They agree with the *thing owned*, not the owner. Add **-s** for plurals: **mis amigos, tus libros**.",
     "examples": [
      {
       "id": "s-mi-hermano",
       "es": "Este es mi hermano.",
       "en": "This is my brother."
      },
      {
       "id": "s-tu-casa",
       "es": "¿Dónde está tu casa?",
       "en": "Where is your house?"
      },
