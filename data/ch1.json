  {
   "id": "l-adjectives",
   "title": "Plurals and adjectives",
   "summary": "Adjectives agree with the noun and follow it.",
   "cards": [
    {
     "rule": "Plurals: vowel + **-s** (casa → casas); consonant + **-es** (ciudad → ciudades); **-z** → **-ces** (lápiz → lápices).",
     "examples": [
      {
       "id": "s-casas",
       "es": "Las casas son bonitas.",
       "en": "The houses are pretty."
      },
      {
       "id": "s-ciudades",
       "es": "Hay dos ciudades grandes.",
       "en": "There are two big cities."
      },
      {
       "id": "s-lapices",
       "es": "Tengo tres lápices.",
       "en": "I have three pencils."
      }
     ]
    },
    {
     "rule": "Adjectives **agree** in gender and number and usually come **after** the noun: **un coche rojo, una casa roja, unos coches rojos**. Adjectives in **-e** or most consonants don't change for gender (grande, azul), except nationalities: **holandés / holandesa**.",
     "examples": [
      {
       "id": "s-coche-rojo",
       "es": "Tengo un coche rojo.",
       "en": "I have a red car."
      },
      {
       "id": "s-casa-roja",
       "es": "Tengo una casa roja.",
       "en": "I have a red house."
      },
      {
       "id": "s-mujer-inteligente",
       "es": "Ella es una mujer inteligente.",
       "en": "She is an intelligent woman."
      }
     ],
     "trap": "Not *una blanca casa*: the adjective follows the noun."
    }
   ],
   "drills": [
