 "lessons": [
  {
   "id": "l-sounds",
   "title": "Sounds, stress and accent marks",
   "summary": "Spanish is spelled as it sounds. Learn the rules once.",
   "cards": [
    {
     "rule": "Five pure vowels: **a e i o u**, always short and clear. **H** is silent. **J** and **g** (before e/i) sound like a rough *h*. **Ñ** sounds like *ny*. **V** sounds like **b**.",
     "examples": [
      {
       "id": "s-hola-ahora",
       "es": "Hola, ¿cómo estás ahora?",
       "en": "Hi, how are you now?"
      },
      {
       "id": "s-jamon-gente",
       "es": "El jamón y la gente.",
       "en": "The ham and the people."
      },
      {
       "id": "s-espanol",
       "es": "Hablo español.",
       "en": "I speak Spanish."
      }
     ],
     "note": "In Spain, **c** before e/i and **z** sound like *th* (cena, zumo). In Latin America they sound like *s*."
    },
    {
     "rule": "Stress: a word ending in a **vowel, n or s** is stressed on the second-to-last syllable (**ha**-bla, **ca**-sa). Any other consonant: stress the last syllable (ha-**blar**, ciu-**dad**). An **accent mark** shows an exception (can-**ción**).",
     "examples": [
      {
       "id": "s-hablan",
       "es": "Ellos hablan despacio.",
       "en": "They speak slowly."
      },
      {
       "id": "s-ciudad",
       "es": "La ciudad es grande.",
       "en": "The city is big."
      },
      {
       "id": "s-cancion",
       "es": "Me gusta esta canción.",
       "en": "I like this song."
      }
     ]
    },
    {
     "rule": "An accent mark can also tell two words apart: **tú** (you) / **tu** (your), **él** (he) / **el** (the), **sí** (yes) / **si** (if), **más** (more), **cómo** (how).",
     "examples": [
      {
       "id": "s-tu-tu",
       "es": "Tú tienes tu libro.",
       "en": "You have your book."
      },
      {
       "id": "s-el-el",
       "es": "Él es el hermano de Ana.",
       "en": "He is Ana's brother."
      }
     ],
     "trap": "Question words always carry an accent: **¿Cómo? ¿Qué? ¿Dónde? ¿Cuándo?**"
    }
   ],
   "drills": [
    "d-sounds-1",
    "d-sounds-2",
    "d-sounds-3",
    "d-sounds-4",
    "d-sounds-5",
    "d-sounds-6"
   ]
  },
  {
   "id": "l-gender",
   "title": "Gender and articles",
   "summary": "Every noun is masculine or feminine. Learn the article with the word.",
   "cards": [
    {
     "rule": "Every noun is **masculine** or **feminine**. Words ending in **-o** are usually masculine (**el** libro), words in **-a** usually feminine (**la** casa). Plural: **los** / **las**.",
     "examples": [
      {
       "id": "s-el-libro",
       "es": "El libro es nuevo.",
       "en": "The book is new."
      },
      {
       "id": "s-la-casa",
       "es": "La casa es grande.",
       "en": "The house is big."
      },
      {
       "id": "s-los-amigos",
       "es": "Los amigos están aquí.",
       "en": "The friends are here."
      }
     ]
    },
    {
     "rule": "Endings **-ción, -sión, -dad** are feminine; **-or** is masculine. Exceptions to learn: **el día**, **el mapa**, **la mano**. Feminine nouns **beginning with a stressed a** use *el*: **el agua**.",
     "examples": [
      {
       "id": "s-la-ciudad",
       "es": "La ciudad es bonita.",
       "en": "The city is pretty."
      },
      {
       "id": "s-el-dia",
       "es": "Hoy es un buen día.",
       "en": "Today is a good day."
      },
      {
       "id": "s-el-agua",
       "es": "El agua está fría.",
       "en": "The water is cold."
      }
     ],
     "trap": "Learn the article with every noun: **la mano**, not just *mano*."
    },
    {
     "rule": "\"A / some\": **un** (m), **una** (f), **unos** (m pl), **unas** (f pl).",
     "examples": [
      {
       "id": "s-un-hermano",
       "es": "Tengo un hermano.",
       "en": "I have a brother."
      },
      {
       "id": "s-una-hermana",
       "es": "Tengo una hermana.",
       "en": "I have a sister."
      },
      {
       "id": "s-unos-libros",
       "es": "Hay unos libros en la mesa.",
       "en": "There are some books on the table."
      }
     ]
    }
   ],
   "drills": [
    "d-gender-1",
    "d-gender-2",
    "d-gender-3",
