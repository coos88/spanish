  {
   "id": "l-ser-estar",
   "title": "ser vs estar",
   "summary": "Two verbs for \"to be\".",
   "cards": [
    {
     "rule": "**ser** = what something *is*: identity, origin, profession, characteristics, time. **soy, eres, es, somos, sois, son**.",
     "examples": [
      {
       "id": "s-soy-holandes",
       "es": "Soy holandés.",
       "en": "I am Dutch."
      },
      {
       "id": "s-mi-madre-medica",
       "es": "Mi madre es médica.",
       "en": "My mother is a doctor."
      },
      {
       "id": "s-son-las-tres",
       "es": "Son las tres.",
       "en": "It is three o'clock."
      }
     ]
    },
    {
     "rule": "**estar** = how or where something *is*: location and temporary state. **estoy, estás, está, estamos, estáis, están**.",
     "examples": [
      {
       "id": "s-madrid-esta",
       "es": "Madrid está en España.",
       "en": "Madrid is in Spain."
      },
      {
       "id": "s-estoy-cansado",
       "es": "Estoy cansado.",
       "en": "I am tired."
      },
      {
       "id": "s-cafe-frio",
       "es": "El café está frío.",
       "en": "The coffee is cold."
      }
     ],
     "trap": "*Ser aburrido* = to be boring, *estar aburrido* = to be bored. Same adjective, different meaning."
    }
   ],
