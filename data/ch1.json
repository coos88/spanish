  {
   "id": "l-present",
   "title": "Present tense and tú / usted",
   "summary": "Regular verbs: drop -ar/-er/-ir and add the endings.",
   "cards": [
    {
     "rule": "Drop **-ar / -er / -ir**, add endings. **-ar**: -o, -as, -a, -amos, -áis, -an. **-er**: -o, -es, -e, -emos, -éis, -en. **-ir**: -o, -es, -e, -imos, -ís, -en.",
     "examples": [
      {
       "id": "s-hablo",
       "es": "Hablo español.",
       "en": "I speak Spanish."
      },
      {
       "id": "s-comemos",
       "es": "Comemos a las dos.",
       "en": "We eat at two."
      },
      {
       "id": "s-viven",
       "es": "Ellos viven en Madrid.",
       "en": "They live in Madrid."
      }
     ],
     "trap": "Skip the pronoun: *Hablo español*, not *Yo hablo español* (unless you contrast)."
    },
    {
     "rule": "**tú** is informal (friends, family, peers). **usted** is formal (strangers, older people) and uses the **he/she** verb form. Plural *you*: **vosotros** (informal, Spain) / **ustedes**.",
     "examples": [
      {
       "id": "s-como-estas",
       "es": "¿Cómo estás, Ana?",
       "en": "How are you, Ana?"
      },
      {
       "id": "s-como-esta-usted",
       "es": "¿Cómo está usted, señora?",
       "en": "How are you, madam?"
      },
      {
       "id": "s-vive-usted",
       "es": "¿Vive usted aquí?",
       "en": "Do you live here?"
      }
     ],
     "note": "In Latin America *vosotros* isn't used: everyone says *ustedes*."
    }
   ],
